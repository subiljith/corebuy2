    replacement_chunks {
      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --font-display: \"Montserrat\", sans-serif;\n  --font-body: \"Inter\", sans-serif;\n  --font-sans: \"Inter\", sans-serif;\n\n  --color-primary: #b02f00;\n  --color-primary-container: #ff5722;\n  --color-primary-fixed: #ffdbd1;\n  --color-primary-fixed-dim: #ffb5a0;\n  --color-on-primary: #ffffff;\n  --color-on-primary-container: #541200;\n\n  --color-secondary: #006d2f;\n  --color-secondary-container: #5dfd8a;\n  --color-on-secondary-container: #007232;\n  --color-whatsapp: #25D366;\n\n  --color-surface: #fcf9f8;\n  --color-surface-container-lowest: #ffffff;\n  --color-surface-container-low: #f6f3f2;\n  --color-surface-container: #f0edec;\n  --color-surface-container-high: #ebe7e7;\n  --color-surface-container-highest: #e5e2e1;\n  \n  --color-on-surface: #1c1b1b;\n  --color-on-surface-variant: #5b4039;\n  --color-outline: #907067;\n  --color-outline-variant: #e4beb4;\n  --color-error: #ba1a1a;\n  --color-on-error: #ffffff;\n}\n\n@layer base {\n  body {\n    font-family: var(--font-body);\n    background-color: var(--color-surface);\n    color: var(--color-on-surface);\n  }\n\n  h1, h2, h3, .font-display {\n    font-family: var(--font-display);\n  }\n}\n\n.material-symbols-outlined {\n  font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n  display: inline-block;\n  vertical-align: middle;\n  line-height: 1;\n}\n\n.material-symbols-outlined.fill {\n  font-variation-settings: \'FILL\' 1, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n}\n\n/* Custom Input Focus State */\n.sport-input {\n  border-width: 1px;\n  border-color: #e4beb4;\n  transition: all 0.2s ease-in-out;\n}\n.sport-input:focus {\n  outline: none;\n  border-width: 2px;\n  border-color: #b02f00;\n}\n\n/* Hide scrollbar for Chrome, Safari and Opera */\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n/* Hide scrollbar for IE, Edge and Firefox */\n.no-scrollbar {\n  -ms-overflow-style: none;  /* IE and Edge */\n  scrollbar-width: none;  /* Firefox */\n}\n"
